# Copy to .env.local and fill in. Never commit real values.
# The app boots without any of these (offline mode: signed out, no DB data).

# --- Supabase (required for auth + data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origin used for OAuth / magic-link redirects (defaults to window.location.origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI agent (optional; falls back to a local heuristic if none set) ---
# Force a provider: anthropic | openai | openrouter | local
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- KendoReact (optional; removes the trial watermark) ---
KENDO_UI_LICENSE=
